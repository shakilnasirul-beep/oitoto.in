# =====================================================================
# OI TOTO! — APACHE CONFIGURATION FOR INFINITYFREE PRODUCTION HOSTING
# =====================================================================

RewriteEngine On

# 1. Protect sensitive configuration files and backend source code
<FilesMatch "^\.env|composer\.(json|lock)|\.git">
    Order allow,deny
    Deny from all
</FilesMatch>

RewriteRule ^backend(/.*)?$ - [F,L]

# 2. High-speed Direct APK Downloads via GitHub Releases (Bypasses 10MB Free Hosting Limit)
Redirect 302 /downloads/OiToto_Customer_v1.0.5.apk https://github.com/shakilnasirul-beep/oitoto.in/releases/download/v1.0.5/OiToto_Customer_v1.0.5.apk
Redirect 302 /downloads/OiToto_Driver_v1.0.5.apk https://github.com/shakilnasirul-beep/oitoto.in/releases/download/v1.0.5/OiToto_Driver_v1.0.5.apk
Redirect 302 /downloads/oi_toto_customer.apk https://github.com/shakilnasirul-beep/oitoto.in/releases/download/v1.0.5/OiToto_Customer_v1.0.5.apk
Redirect 302 /downloads/oi_toto_driver.apk https://github.com/shakilnasirul-beep/oitoto.in/releases/download/v1.0.5/OiToto_Driver_v1.0.5.apk
Redirect 302 /downloads/OiToto_Customer_v1.0.4.apk https://github.com/shakilnasirul-beep/oitoto.in/releases/download/v1.0.5/OiToto_Customer_v1.0.5.apk
Redirect 302 /downloads/OiToto_Driver_v1.0.4.apk https://github.com/shakilnasirul-beep/oitoto.in/releases/download/v1.0.5/OiToto_Driver_v1.0.5.apk

# 3. REST API routing to /api/index.php
RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

# 4. MIME Types & Encodings
<IfModule mod_mime.c>
    AddType application/vnd.android.package-archive .apk
    AddType image/svg+xml .svg .svgz
    AddType application/javascript .js
    AddType text/css .css
    AddType application/json .json
</IfModule>

# 5. Caching rules for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
