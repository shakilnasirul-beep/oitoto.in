APP_NAME="Oi Toto!"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Credentials (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oitoto_db
DB_USER=root
DB_PASS=

# JWT Secret Key for API Authentication
JWT_SECRET=OiTotoPanIndiaERickshawSecretKey2026_SecureKeyXYZ987654321
JWT_EXPIRY_DAYS=30

# OTP & SMS Gateway Configuration
# Options: sandbox (default, prints OTP in response/logs for test), fast2sms, msg91, twilio
SMS_PROVIDER=sandbox
SMS_API_KEY=
SMS_SENDER_ID=OITOTO
OTP_DEFAULT_BYPASS=false
OTP_TEST_CODE=123456

# Map Service Configuration
MAP_PROVIDER=osm
GOOGLE_MAPS_API_KEY=

# Payment Gateway Configuration (Indian UPI & Cards)
PAYMENT_GATEWAY=razorpay_upi
RAZORPAY_KEY_ID=rzp_test_oitoto_demo2026
RAZORPAY_KEY_SECRET=oitoto_test_secret_key_98765
PAYMENT_MODE=sandbox

# Firebase Cloud Messaging
FCM_SERVER_KEY=

# File Upload Settings
UPLOAD_MAX_FILESIZE_MB=10
